{
  "name": "statement-to-dashboard",
  "version": "0.1.0",
  "description": "Turn messy bank-statement CSV exports into clean, categorised transactions and a spending dashboard. Runs entirely in the browser; nothing is uploaded.",
  "license": "MIT",
  "author": "Harshal Sahetiya",
  "type": "module",
  "bin": { "statement-parse": "bin/statement-parse.mjs" },
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "files": ["dist/lib", "bin", "README.md", "LICENSE"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:lib": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
